<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Donate surplus food"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tell the community what food is available and where to collect it."
            android:textSize="14sp" />

        <EditText
            android:id="@+id/foodNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Food name, e.g. packed sandwiches"
            android:inputType="textCapSentences"
            android:singleLine="true" />

        <EditText
            android:id="@+id/categoryInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Category, e.g. prepared meal"
            android:inputType="textCapWords"
            android:singleLine="true" />

        <EditText
            android:id="@+id/quantityInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Quantity (number of portions)"
            android:inputType="number"
            android:singleLine="true" />

        <EditText
            android:id="@+id/areaInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Collection area, e.g. Ampang"
            android:inputType="textCapWords"
            android:singleLine="true" />

        <EditText
            android:id="@+id/pickupDetailsInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Pickup place and time"
            android:inputType="textCapSentences"
            android:minLines="2" />

        <EditText
            android:id="@+id/expiryInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:hint="Use-by date (tap to choose)"
            android:inputType="none" />

        <EditText
            android:id="@+id/notesInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Food notes or allergens (optional)"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="2" />

        <Button
            android:id="@+id/postDonationBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Post donation" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="My donation history"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/historyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="No donations yet."
            android:textSize="15sp" />

    </LinearLayout>
</ScrollView>