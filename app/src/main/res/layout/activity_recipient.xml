<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/spacing_medium">

<!--        header-->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/recipient"
            android:textColor="@color/secondary_text"
            android:textSize="@dimen/title_size"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/recipient_desc"
            android:textColor="@color/secondary_text"
            android:textSize="@dimen/body_size"/>

<!--charity section-->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="Food Assistance"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/body_size"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/findCharityBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:backgroundTint="@color/button"
            android:text="Find Charity Near Me"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"/>

<!--        quick access-->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="Quick Access"
            android:textColor="@color/primary_text"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/availableFood"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/padding_small">

            <!--icon here-->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:gravity="center"
                    android:text="Available Food"
                    android:textColor="@color/primary_text"
                    android:textSize="@dimen/body_size"
                    android:textStyle="bold"/>
            </LinearLayout>

<!--Recipient requests-->
            <LinearLayout
                android:id="@+id/myRequests"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

<!--icon for requests here-->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:gravity="center"
                    android:text="My Requests"
                    android:textColor="@color/primary_text"
                    android:textSize="@dimen/body_size"
                    android:textStyle="bold"/>

            </LinearLayout>
        </LinearLayout>

<!--second row-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

<!--pickup stats-->
            <LinearLayout
                android:id="@+id/pickupStatus"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/padding_small">

<!--icon pickup code here-->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:gravity="center"
                    android:text="Pickup Status"
                    android:textColor="@color/primary_text"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!--Recipient requests-->
            <LinearLayout
                android:id="@+id/history"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <!--icon for history here-->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:gravity="center"
                    android:text="History"
                    android:textColor="@color/primary_text"
                    android:textSize="@dimen/body_size"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center"
            android:text="@string/quotes4recip1"
            android:textColor="@color/secondary_text"
            android:textSize="13sp"/>

    </LinearLayout>

</ScrollView>